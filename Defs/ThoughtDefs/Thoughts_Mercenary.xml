<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Situational thought shown to any pawn whose ideoligion has the Mercenary meme. The worker gates
       who sees it and picks the stage by the sign of the company's morale; the custom thought class
       overrides MoodOffset() to return that morale (-20..+20) from the MercenaryMoraleTracker, so the mood
       value slides as bounties push it up and idleness drifts it down. Stage 0 is the buff (content),
       stage 1 the equal-and-opposite debuff (restless). The stages just supply the labels/descriptions. -->
  <ThoughtDef>
    <defName>WR_MercenaryMorale</defName>
    <thoughtClass>MercenaryCreed.Thought_MercenaryMorale</thoughtClass>
    <workerClass>MercenaryCreed.ThoughtWorker_MercenaryMorale</workerClass>
    <validWhileDespawned>true</validWhileDespawned>
    <stages>
      <li>
        <label>mercenary contracts fulfilled</label>
        <description>The company has been earning its keep. Good coin, good work, and the next bounty always waiting.</description>
        <baseMoodEffect>1</baseMoodEffect>
      </li>
      <li>
        <label>mercenary contracts neglected</label>
        <description>No contracts, no coin, no purpose. A company built for the hunt grows restless and sour with nothing to chase.</description>
        <baseMoodEffect>-1</baseMoodEffect>
      </li>
    </stages>
  </ThoughtDef>

</Defs>
