<savedideo>
	<ideo>
		<foundation Class="IdeoFoundation_Deity">
			<def>Deity</def>
			<place>Iwamura</place>
			<deities />
		</foundation>
		<name>Mercenary Creed</name>
		<adjective>mercenary</adjective>
		<memberName>Mercenary</memberName>
		<leaderTitleMale>Captain</leaderTitleMale>
		<leaderTitleFemale>Captain</leaderTitleFemale>
		<description>War is a trade, and the Mercenary Creed plies it better than most. Bound by contract and coin rather than crown or creed, the company takes every bounty as one and leaves no job unfinished and no debt unsettled.</description>
		<descriptionLocked>True</descriptionLocked>
		<culture>DankPyon_OldWorlder</culture>
		<iconDef>Ouroboros</iconDef>
		<colorDef>DarkGrey</colorDef>
		<memes>
			<li>Structure_Ideological</li>
			<li>WR_Mercenary</li>
			<li>Collectivist</li>
		</memes>
